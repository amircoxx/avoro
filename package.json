{
  "name": "find-my-tech",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace @find-my-tech/frontend",
    "dev:backend": "npm run dev --workspace @find-my-tech/backend",
    "build": "npm run build --workspace @find-my-tech/frontend && npm run build --workspace @find-my-tech/backend",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "node backend/scripts/with-env.mjs generate",
    "db:push": "node backend/scripts/with-env.mjs db push",
    "db:studio": "node backend/scripts/with-env.mjs studio",
    "db:deploy": "node backend/scripts/with-env.mjs migrate deploy",
    "db:status": "node backend/scripts/with-env.mjs migrate status",
    "db:migrate": "node backend/scripts/with-env.mjs migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.1.12",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^0.487.0",
    "next": "16.2.10",
    "prisma": "^6.19.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.3",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "concurrently": "^9.2.1",
    "typescript": "5.8.2",
    "vitest": "3.2.6"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
